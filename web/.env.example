# Copy to .env to override the defaults. Everything here is built into the
# browser bundle and is PUBLIC: never put passwords, database URLs or
# server-side keys in this file.

# Laravel API base URL. Use the same host name as the web app
# (localhost with localhost, 127.0.0.1 with 127.0.0.1) so the session cookie works.
REACT_APP_API_URL=http://localhost:8000/api

# Optional Google Maps Embed API key, restricted to this site's HTTP referrers
# and to the Maps Embed API only. Leave empty to show a plain map link.
REACT_APP_GOOGLE_MAPS_EMBED_KEY=
