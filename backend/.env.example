APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Web app address, used for links in emails (password reset).
FRONTEND_URL=http://localhost:3001
# Browser origins allowed to call the API (comma-separated). Native mobile
# apps are not affected by CORS. Add http://localhost:8081 for Expo web.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Minutes until an API token expires (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
# Web app hosts that get cookie sessions instead of tokens (host[:port], comma-separated).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Production: APP_ENV=production, APP_DEBUG=false, HTTPS-only APP_URL/FRONTEND_URL,
# SESSION_SECURE_COOKIE=true and SESSION_DOMAIN set to the shared parent domain.
# SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase PostgreSQL. Copy the values from Supabase > Project Settings >
# Database > Connection string. Never commit the real values.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.untglhmcbhcouujcybkz:*KrisMCgonz329@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.untglhmcbhcouujcybkz
DB_PASSWORD=*KrisMCgonz329
DB_SSLMODE=require
# Reuse database connections between web requests (defaults to true for the
# local web server when APP_ENV=local; never used for artisan commands).
# DB_PERSISTENT=true
# Port 6543 is Supabase's transaction pooler (fine for the app). For
# migrations use session mode: DB_PORT=5432 php artisan migrate

# Local: keep sessions and cache on disk so each request does not make extra
# round trips to the remote database. Use database/redis when running several servers.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password for the LOCAL demo accounts created by DemoUsersSeeder / DemoClinicDataSeeder
# (the seeders only run when APP_ENV=local). The apps' development-only auto-fill
# buttons assume the default.
# DEMO_USER_PASSWORD=DemoPass2026

# php artisan serve: 0.0.0.0 lets phones on the same network reach the API
# (local development only; allow port 8000 in the PC firewall).
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
